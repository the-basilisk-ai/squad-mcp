{
  "name": "squad-mcp",
  "version": "4.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "test": "vitest run",
    "prepare": "husky",
    "format": "biome check .",
    "format:fix": "biome check --write .",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@posthog/mcp": "^0.9.1",
    "@propelauth/node": "^2.1.35",
    "dotenv": "^17.4.2",
    "graphql": "^17.0.2",
    "mcp-use": "^2.0.4",
    "posthog-node": "^5.45.2",
    "redis": "^5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@types/node": "^24",
    "hono": "^4.12.34",
    "husky": "^9.1.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.32.1"
}
